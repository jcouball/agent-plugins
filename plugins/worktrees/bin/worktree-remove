#!/usr/bin/env bash
#
# WorktreeRemove hook. Claude Code runs this when a session leaves a worktree
# it was told to remove, in place of removing the worktree itself.
#
# The branch is left alone. Claude Code asked for the worktree to go, not the
# work in it, and an unmerged branch is cheap to keep and expensive to lose.

set -euo pipefail

event=$(cat)
worktree=$(printf '%s' "$event" | jq -re '.worktree_path')
cwd=$(printf '%s' "$event" | jq -re '.cwd')

# A main worktree is not a worktree to remove: taking it would take the
# repository with it. git refuses that on its own when asked by name, but the
# removal below answers a failed removal with prune, which would swallow the
# refusal and report a registration it could not clear. So it is refused here
# instead, while the refusal can still be said plainly.
#
# A linked worktree's git dir sits inside the common dir, at
# <common>/worktrees/<name>; a main worktree's is the common dir. That holds
# however the repository was laid out, including the separate-git-dir case
# where the .git a linked worktree carries as a file is one here too.
if git -C "$worktree" rev-parse --git-dir >/dev/null 2>&1; then
  git_dir=$(git -C "$worktree" rev-parse --path-format=absolute --git-dir)
  git_common=$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir)
  if [ "$git_dir" = "$git_common" ]; then
    printf '%s\n' \
      "worktree-remove: $worktree is a repository's main worktree, not a linked worktree," \
      "so it was left where it is." >&2
    exit 1
  fi
fi

# The path names its own owner. Every container this plugin makes is
# <main worktree>.worktrees, and the layout it stands aside for is
# <main worktree>/.claude/worktrees, so walking up to the first of those gives
# both the tree that holds the registration and the container to stop at when
# the directories are taken away at the end.
d=$(dirname -- "$worktree")
derived=""
container=""
while :; do
  case $d in
  */.claude/worktrees)
    derived=${d%/.claude/worktrees}
    container=$d
    break
    ;;
  *.worktrees)
    derived=${d%.worktrees}
    container=$d
    break
    ;;
  / | .)
    break
    ;;
  esac
  d=$(dirname -- "$d")
done

# Is $worktree in this repository's registry?
registered() {
  local registry
  registry=$(git -C "$1" worktree list --porcelain 2>/dev/null) || return 1
  awk -v want="worktree $worktree" '$0 == want { found = 1 } END { exit !found }' <<<"$registry"
}

# Which repository is asked to do the removal. The worktree answers for itself
# while it is still a worktree, so it is tried first and the ordinary case
# needs nothing else. It stops answering the moment its registration goes --
# an interrupted earlier run, a hand-edited .git/worktrees, gc's own worktree
# prune -- and `git -C <worktree>` then fails with `not a git repository`
# instead of reaching a repository that could still clear it. That is the
# mirror of the case below and it has to reach the same two candidates.
#
# $derived is where the path says the registration lives, and $cwd is the
# fallback for a worktree laid out some other way; it is the session's
# directory, which may be the one that just vanished.
#
# $looked records whether any candidate turned out to be a repository at all. A
# repository that was asked and did not hold the registration is a real answer
# -- the registration is already clear -- but having asked nothing is not, and
# the two are otherwise indistinguishable from the silence that follows.
looked=""
owner=""
for repo in "$worktree" "$derived" "$cwd"; do
  [ -n "$repo" ] && [ -d "$repo" ] || continue
  git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || continue
  looked=yes
  if registered "$repo"; then
    owner=$repo
    break
  fi
done

# Only the repository that holds the registration is asked to clear it, so a
# second removal of the same path finds nothing to do and says nothing, and no
# other repository is touched.
#
# Forced, because Claude Code asks before choosing removal and this runs after
# that answer. One call covers both states: a live worktree loses its directory
# and its registration, and a registration whose directory is already gone
# loses the registration, which is not the no-op it looks like -- git goes on
# refusing to check that branch out anywhere else while it stands. prune is the
# fallback for a git too old to remove a worktree whose directory it cannot
# find; it takes every stale registration in that repository rather than only
# this one.
cleared=""
if [ -n "$owner" ]; then
  git -C "$owner" worktree remove --force -- "$worktree" >/dev/null 2>&1 ||
    git -C "$owner" worktree prune >&2
  registered "$owner" || cleared=yes
fi

# The directory outlived its registration, so there is nothing left for git to
# remove it by name and the directory is this hook's to take. Nothing here is
# a repository: one that still is answers the loop above and becomes the owner,
# and a main worktree was refused before any of this.
if [ -z "$owner" ] && [ -d "$worktree" ]; then
  rm -rf -- "$worktree"
fi

if [ -n "$owner" ] && [ -z "$cleared" ]; then
  # A locked worktree is the usual reason: git refuses to remove one on a
  # single --force, and prune passes over it too, so the registration outlives
  # both calls above and goes on holding the branch.
  printf '%s\n' \
    "worktree-remove: $worktree is already gone, but its git registration could not be" \
    "cleared, so git still holds its branch. If the worktree is locked, unlock it first:" \
    "  git -C '$owner' worktree unlock '$worktree'" \
    "  git -C '$owner' worktree prune" >&2
elif [ -z "$looked" ]; then
  printf '%s\n' \
    "worktree-remove: $worktree is already gone, and no repository was found to clear its" \
    "registration from. If git refuses to check that branch out, its registration is still" \
    "standing: run 'git worktree prune' in the repository that owns it to free the branch." >&2
fi

# Take the container with it once the last worktree leaves, and stop there.
# rmdir -p would climb past the container into the directory holding it, which
# for the nested layout is the project's own .claude -- not this plugin's to
# remove, and gone the moment it holds nothing else. A layout this hook does
# not recognize has no container to take, so nothing is climbed at all.
if [ -n "$container" ]; then
  d=$(dirname -- "$worktree")
  while :; do
    rmdir -- "$d" 2>/dev/null || break
    if [ "$d" = "$container" ]; then break; fi
    d=$(dirname -- "$d")
  done
fi
