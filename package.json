{
  "name": "jcouball-agent-plugins",
  "private": true,
  "description": "Tooling for the jcouball agent plugin marketplace. Not published.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "test:run": "node --test \"scripts/*.test.mjs\" \"plugins/*/scripts/*.test.mjs\"",
    "test": "node --test --experimental-test-isolation=none --import=./scripts/no-child-coverage.mjs --experimental-test-coverage --test-coverage-branches=100 --test-coverage-lines=100 --test-coverage-exclude='**/*.test.mjs' --test-coverage-exclude='**/fake-gh.mjs' --test-coverage-exclude='**/fake-gh-cli.mjs' --test-coverage-exclude='**/fake-executable.mjs' --test-coverage-exclude='**/fake-environment.mjs' --test-coverage-exclude='**/vendor/**' --test-coverage-exclude='**/no-child-coverage.mjs' --test-coverage-exclude='**/*.cases.mjs' \"scripts/*.test.mjs\" \"plugins/*/scripts/*.test.mjs\"",
    "lint:manifests": "node scripts/check-manifests.mjs",
    "lint:links": "node scripts/check-links.mjs",
    "lint:actions": "node scripts/check-actions.mjs",
    "lint:markdown": "markdownlint-cli2",
    "lint:commits": "commitlint --from origin/main --to HEAD",
    "ci": "npm test && npm run lint:manifests && npm run lint:links && npm run lint:actions && npm run lint:markdown && npm run lint:commits",
    "sync": "node scripts/sync-plugins.mjs",
    "probe:github": "node scripts/probe-github-rendering.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "github-slugger": "^2.0.0",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.23.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "micromark": "^4.0.3",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "parse5": "^8.0.1",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
